# Identity used when calling lark-cli.
# Bot permission window: the bot cannot be added to internal chats yet, so the
# project baseline continues with "user". Once im:message:readonly is enabled
# and the bot is added to the whitelisted chats, switch to LARK_IDENTITY=bot and
# run doctor + sync again to complete the bot acceptance pass.
LARK_IDENTITY=user

# Data boundary: comma-separated internal chat ids allowed to sync.
# Leave empty to allow every internal chat visible to the identity.
FEISHU_AGENT_ALLOWED_CHAT_IDS=

# External group policy: keep 0 to exclude external chats from every sync.
FEISHU_AGENT_ALLOW_EXTERNAL_CHATS=0

# Local SQLite database file.
FEISHU_AGENT_DB=data/agent.db

# Periodic sync interval in seconds (used by "serve --interval").
FEISHU_AGENT_SYNC_INTERVAL=60

# M3 summary budgets. Rule mode is the deterministic default baseline.
FEISHU_AGENT_SUMMARY_MAX_CHARS=4000
FEISHU_AGENT_SUMMARY_INPUT_TOKEN_BUDGET=6000
FEISHU_AGENT_SUMMARY_OUTPUT_TOKEN_BUDGET=1200
FEISHU_AGENT_SUMMARY_MIN_NEW_MESSAGES=1

# Optional OpenAI-compatible /chat/completions endpoint for LLM summaries.
FEISHU_AGENT_LLM_API_URL=
FEISHU_AGENT_LLM_API_KEY=
FEISHU_AGENT_LLM_MODEL=
FEISHU_AGENT_LLM_TIMEOUT=60

# M4 agent harness budgets and safety controls. Rule mode is the deterministic
# default; LLM planning is optional and uses the OpenAI-compatible endpoint.
FEISHU_AGENT_MAX_QUESTION_CHARS=2000
FEISHU_AGENT_MAX_ANSWER_CHARS=2000
FEISHU_AGENT_MAX_EVIDENCE_ITEMS=10
FEISHU_AGENT_MAX_STEPS=5
FEISHU_AGENT_SENSITIVE_WORDS=password,secret,api_key,access_token,密钥,密码,身份证号,银行卡号

# Optional HTTP API protection for /api/agent/*. Empty token disables auth;
# rate limit 0 disables the in-process rate limiter.
FEISHU_AGENT_API_TOKEN=
FEISHU_AGENT_RATE_LIMIT_PER_MIN=0

# lark-cli runtime paths on this machine.
LARK_NODE=node
LARK_CLI_JS=D:\App\nodejs\node_global\node_modules\@larksuite\cli\scripts\run.js
